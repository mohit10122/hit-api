name: Hit API Every 9 Minutes

on:
  schedule:
    # Ye cron job har 9 minute me run hogi
    - cron: '*/9 * * * *'
  workflow_dispatch: # Isse aap manually bhi run kar sakte ho zaroorat padne par

jobs:
  call_api:
    runs-on: ubuntu-latest
    steps:
      - name: Call my API
        # Apni API ka URL yahan daal do
        run: |
          curl -X GET "https://staffpro.onrender.com/Api/Staff/login"
